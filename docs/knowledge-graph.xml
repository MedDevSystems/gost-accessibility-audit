<KnowledgeGraph>
  <Project NAME="gost-a11y-automation" VERSION="0.2.0">
    <keywords>accessibility, a11y, GOST, WCAG, government-sites, Playwright, axe-core, LLM, automated-testing, web-accessibility, FastAPI, audit-webapp, SSE, Lighthouse-style</keywords>
    <annotation>Автоматизированное тестирование веб-сайтов на соответствие российским ГОСТам по доступности (ГОСТ Р 52872-2019, WCAG 2.1 A/AA, Приказ Минцифры №953). Script-First архитектура с LLM как fallback. Веб-интерфейс аудита в стиле Lighthouse с SSE-стримингом результатов.</annotation>

    <!-- ===== Core Modules ===== -->

    <M-MODELS NAME="Models" TYPE="UTILITY">
      <purpose>Модели данных: Verdict, CheckResult, CandidateInfo, FallbackContext, LLMVerdict</purpose>
      <path>gost_a11y/models.py</path>
      <depends>none</depends>
      <annotations>
        <class-Verdict PURPOSE="Enum вердиктов: PASS/FAIL/UNCERTAIN" />
        <class-CheckResult PURPOSE="Результат одной проверки" />
        <class-CandidateInfo PURPOSE="Сырая информация о найденном элементе" />
        <class-ClassifiedCandidate PURPOSE="Кандидат после классификации" />
        <class-FallbackContext PURPOSE="Контекст для LLM fallback" />
        <class-LLMVerdict PURPOSE="Вердикт от LLM-агента" />
      </annotations>
    </M-MODELS>

    <M-LOGGER NAME="Logger" TYPE="UTILITY">
      <purpose>Структурированный ГОСТ-aware логгер, grep-friendly формат</purpose>
      <path>gost_a11y/logger.py</path>
      <depends>none</depends>
      <annotations>
        <fn-setup_logger PURPOSE="Настройка логгера с консолью и файлом" />
        <fn-log_check PURPOSE="Лог шага проверки" />
        <fn-log_fallback_context PURPOSE="Лог контекста для LLM" />
        <fn-log_llm_verdict PURPOSE="Лог вердикта LLM" />
        <fn-log_result PURPOSE="Лог итогового результата" />
      </annotations>
    </M-LOGGER>

    <M-BROWSER NAME="Browser" TYPE="INTEGRATION">
      <purpose>Playwright lifecycle — контекстный менеджер для открытия страницы с антибот-защитой</purpose>
      <path>gost_a11y/browser.py</path>
      <depends>none</depends>
      <annotations>
        <fn-open_page PURPOSE="Async context manager: браузер → страница → навигация с антибот-защитой" />
        <fn-_is_antibot_page PURPOSE="Детекция антибот-страницы (Яндекс SmartCaptcha)" />
        <fn-_navigate_with_antibot_wait PURPOSE="Навигация с ожиданием и retry при антиботе" />
      </annotations>
    </M-BROWSER>

    <M-AXE NAME="AxeHelper" TYPE="INTEGRATION">
      <purpose>Инжекция axe-core через Playwright, запуск по правилам</purpose>
      <path>gost_a11y/axe_helper.py</path>
      <depends>M-BROWSER</depends>
      <annotations>
        <fn-inject_axe PURPOSE="Инжекция axe.min.js в страницу (кешируется)" />
        <fn-run_axe PURPOSE="Запуск axe-core с фильтром по правилам" />
      </annotations>
    </M-AXE>

    <M-LLM NAME="LLMFallback" TYPE="INTEGRATION">
      <purpose>OpenRouter API интеграция (qwen/qwen3.5-35b-a3b) для LLM fallback</purpose>
      <path>gost_a11y/llm_fallback.py</path>
      <depends>M-MODELS</depends>
      <annotations>
        <fn-call_llm PURPOSE="Вызов OpenRouter API для вынесения вердикта" />
        <fn-_build_system_prompt PURPOSE="Формирование системного промпта для LLM" />
        <fn-_build_user_message PURPOSE="Формирование сообщения с контекстом проверки" />
        <fn-_parse_llm_response PURPOSE="Парсинг JSON-ответа LLM в LLMVerdict" />
      </annotations>
    </M-LLM>

    <M-BASE-CHECK NAME="BaseCheck" TYPE="CORE_LOGIC">
      <purpose>Абстрактный базовый класс GostCheck — 4-шаговый пайплайн проверки</purpose>
      <path>gost_a11y/base_check.py</path>
      <depends>M-MODELS, M-LOGGER, M-LLM</depends>
      <annotations>
        <class-GostCheck PURPOSE="ABC: collect → classify → judge → fallback" />
        <fn-run PURPOSE="Оркестрация полного цикла проверки" />
        <fn-build_fallback_context PURPOSE="Формирование контекста для LLM" />
        <fn-invoke_llm PURPOSE="Вызов LLM-агента при UNCERTAIN" />
      </annotations>
    </M-BASE-CHECK>

    <M-REGISTRY NAME="Registry" TYPE="CORE_LOGIC">
      <purpose>Реестр всех 22 проверок — упорядоченный список инстансов GostCheck</purpose>
      <path>gost_a11y/registry.py</path>
      <depends>M-BASE-CHECK, M-CHECKS</depends>
      <annotations>
        <fn-get_all_checks PURPOSE="Возвращает все зарегистрированные проверки" />
        <fn-get_checks_by_gost PURPOSE="Фильтр проверок по ГОСТ ID" />
      </annotations>
    </M-REGISTRY>

    <M-CHECKS NAME="Checks" TYPE="CORE_LOGIC">
      <purpose>22 проверки доступности в 5 фазах (скрипт, axe-core, спецверсия, гибридные, AI)</purpose>
      <path>gost_a11y/checks/</path>
      <depends>M-BASE-CHECK, M-AXE, M-LLM, M-MODELS</depends>
    </M-CHECKS>

    <M-RUNNER NAME="Runner" TYPE="ENTRY_POINT">
      <purpose>CLI точка входа: двойной прогон (основная + спецверсия), сравнительная таблица, JSON-отчёт</purpose>
      <path>gost_a11y/runner.py</path>
      <depends>M-BROWSER, M-REGISTRY, M-MODELS, M-LOGGER</depends>
      <annotations>
        <fn-run_checks PURPOSE="Запуск всех 22 проверок на основной странице" />
        <fn-run_checks_special PURPOSE="Поиск кнопки спецверсии, клик, прогон 20 проверок в изолированном контексте" />
        <fn-run_full PURPOSE="Оркестрация: основная страница + спецверсия" />
        <fn-print_summary PURPOSE="Сравнительная таблица основная vs спецверсия" />
        <fn-save_report PURPOSE="JSON-отчёт с main + special_version секциями" />
        <fn-main PURPOSE="CLI точка входа с аргументами --no-headless, --no-special, --output" />
      </annotations>
    </M-RUNNER>

    <M-TARGETS NAME="Targets" TYPE="DATA_LAYER">
      <purpose>Реестр целевых госсайтов (~120 + эталон ВОС) с категоризацией</purpose>
      <path>gost_a11y/targets.py</path>
      <depends>none</depends>
      <annotations>
        <class-TargetSite PURPOSE="Dataclass целевого сайта (id, name, url, category, description, special_url, tags)" />
        <const-REFERENCE_SITE PURPOSE="Эталонный сайт ВОС для калибровки" />
        <const-TARGET_SITES PURPOSE="Список ~120 целевых госсайтов" />
        <fn-get_all_targets PURPOSE="Все сайты включая эталон" />
        <fn-get_targets_by_category PURPOSE="Фильтр сайтов по категории" />
        <fn-get_reference_site PURPOSE="Получить только эталон ВОС" />
      </annotations>
    </M-TARGETS>

    <M-BATCH NAME="BatchRunner" TYPE="ENTRY_POINT">
      <purpose>Batch-прогон по всем целевым сайтам с изолированными отчётами</purpose>
      <path>run_all_targets.py</path>
      <depends>M-BROWSER, M-REGISTRY, M-TARGETS, M-MODELS</depends>
      <annotations>
        <fn-run_all PURPOSE="Прогон всех проверок по всем сайтам" />
        <fn-check_site PURPOSE="Проверка одного сайта с изолированным логированием" />
        <fn-_setup_site_logger PURPOSE="Настройка изолированного логгера для сайта" />
        <fn-_save_site_report PURPOSE="Сохранение JSON-отчёта для одного сайта" />
      </annotations>
    </M-BATCH>

    <!-- ===== Dashboard ===== -->

    <M-BUILD-DASHBOARD NAME="BuildDashboard" TYPE="UTILITY">
      <purpose>Генерация report.json для React-дашборда из batch-отчётов</purpose>
      <path>build_dashboard.py</path>
      <depends>M-BATCH</depends>
      <annotations>
        <fn-find_latest_batch_dir PURPOSE="Поиск последней директории reports/batch_*" />
        <fn-load_batch_data PURPOSE="Чтение summary.json + per-site JSON" />
        <fn-generate_demo_data PURPOSE="Генерация демо-данных при отсутствии отчётов" />
        <fn-generate_report_json PURPOSE="Запись dashboard/src/data/report.json" />
        <fn-main PURPOSE="CLI: python3 build_dashboard.py [batch_dir]" />
      </annotations>
    </M-BUILD-DASHBOARD>

    <M-DASHBOARD NAME="Dashboard" TYPE="UI_COMPONENT">
      <purpose>React+TypeScript+Vite SPA — визуализация результатов проверок госсайтов</purpose>
      <path>dashboard/</path>
      <depends>M-BUILD-DASHBOARD</depends>
      <annotations>
        <fn-App PURPOSE="Корневой компонент: категоризация, группировка, layout" />
        <fn-CategorySection PURPOSE="Группировка сайтов по категории с раскрытием" />
        <fn-ChecksTable PURPOSE="Таблица результатов проверок для сайта" />
        <fn-FontControls PURPOSE="Управление размером шрифта" />
        <fn-Stats PURPOSE="Сводная статистика (avg %, total sites)" />
        <fn-Reference PURPOSE="Справочник ГОСТ/WCAG маппингов" />
        <fn-useFontSize PURPOSE="Custom hook: состояние шрифта с localStorage" />
        <type-CheckResult PURPOSE="Интерфейс результата проверки (TS)" />
        <type-SiteSummary PURPOSE="Интерфейс сводки по сайту (TS)" />
        <type-SiteReport PURPOSE="Интерфейс отчёта по сайту (TS)" />
        <type-ReportData PURPOSE="Интерфейс корневых данных отчёта (TS)" />
      </annotations>
    </M-DASHBOARD>

    <!-- ===== Audit Web App ===== -->

    <M-AUDIT-SCHEMAS NAME="AuditSchemas" TYPE="UTILITY">
      <purpose>Pydantic-модели для Audit API: запросы, ответы, SSE-события</purpose>
      <path>audit/backend/schemas.py</path>
      <depends>M-MODELS</depends>
      <annotations>
        <class-AuditRequest PURPOSE="Валидация входящего запроса: urls, include_special" />
        <class-CheckResultOut PURPOSE="Сериализация результата проверки для SSE/JSON" />
        <class-AuditSummary PURPOSE="Сводка: total, passed, failed, uncertain, score_pct" />
        <class-PageReport PURPOSE="Полный отчёт по одной странице" />
        <class-AuditStatus PURPOSE="Текущий статус задачи аудита" />
        <fn-category_for_gost_section PURPOSE="Маппинг gost_section → категория ГОСТ" />
      </annotations>
    </M-AUDIT-SCHEMAS>

    <M-AUDIT-TASKSTORE NAME="TaskStore" TYPE="DATA_LAYER">
      <purpose>In-memory хранилище задач аудита с asyncio.Queue для SSE-стриминга</purpose>
      <path>audit/backend/task_store.py</path>
      <depends>none</depends>
      <annotations>
        <class-TaskStore PURPOSE="Singleton: создание задач, push/subscribe событий" />
        <class-AuditTask PURPOSE="Задача: id, status, queue, results, semaphore" />
        <class-SSEEvent PURPOSE="SSE-событие: event_type, data (JSON)" />
      </annotations>
    </M-AUDIT-TASKSTORE>

    <M-AUDIT-ENGINE NAME="AuditEngine" TYPE="CORE_LOGIC">
      <purpose>Движок аудита — обёртка над get_all_checks() + open_page() с per-check SSE-стримингом</purpose>
      <path>audit/backend/audit_engine.py</path>
      <depends>M-REGISTRY, M-BROWSER, M-AUDIT-TASKSTORE, M-AUDIT-SCHEMAS</depends>
      <annotations>
        <fn-run_audit PURPOSE="Async: запуск полного аудита, push_event после каждой проверки" />
      </annotations>
    </M-AUDIT-ENGINE>

    <M-AUDIT-API NAME="AuditAPI" TYPE="ENTRY_POINT">
      <purpose>FastAPI эндпоинты: POST /api/audit, GET /api/audit/{id}/stream (SSE), GET /api/checks</purpose>
      <path>audit/backend/api.py</path>
      <depends>M-AUDIT-ENGINE, M-AUDIT-SCHEMAS, M-AUDIT-TASKSTORE</depends>
      <annotations>
        <fn-start_audit PURPOSE="POST /api/audit — создание задачи, запуск asyncio.Task" />
        <fn-stream_results PURPOSE="GET /api/audit/{id}/stream — SSE-стрим результатов" />
        <fn-get_status PURPOSE="GET /api/audit/{id} — polling fallback" />
        <fn-list_checks PURPOSE="GET /api/checks — метаданные всех 22 проверок" />
      </annotations>
    </M-AUDIT-API>

    <M-AUDIT-APP NAME="AuditApp" TYPE="ENTRY_POINT">
      <purpose>FastAPI-приложение: CORS, .env загрузка, sys.path, монтирование роутера</purpose>
      <path>audit/backend/main.py</path>
      <depends>M-AUDIT-API</depends>
      <annotations>
        <fn-app PURPOSE="FastAPI instance — точка входа для uvicorn" />
      </annotations>
    </M-AUDIT-APP>

    <M-AUDIT-UI NAME="AuditUI" TYPE="UI_COMPONENT">
      <purpose>React+TypeScript+Vite SPA — интерактивный аудит Lighthouse-style с HTML-экспортом</purpose>
      <path>audit/frontend/</path>
      <depends>M-AUDIT-API</depends>
      <annotations>
        <fn-App PURPOSE="Корневой компонент: форма + прогресс + отчёт" />
        <fn-AuditForm PURPOSE="Ввод URL + кнопка запуска аудита" />
        <fn-ScoreGauge PURPOSE="Круговой SVG-индикатор оценки (N/22)" />
        <fn-ProgressBar PURPOSE="Прогресс проверки в реальном времени" />
        <fn-ReportView PURPOSE="Полный отчёт: gauge + категории + экспорт" />
        <fn-CategoryGroup PURPOSE="Группа проверок по категории ГОСТ" />
        <fn-CheckItem PURPOSE="Одна проверка: вердикт + описание + спойлер" />
        <fn-ViolationNode PURPOSE="Проблемный HTML-элемент: код + селектор + impact" />
        <fn-ExportButton PURPOSE="Кнопка сохранения HTML-отчёта" />
        <fn-useAudit PURPOSE="Hook: стейт-машина (idle→running→completed|error)" />
        <type-CheckResultOut PURPOSE="TS-интерфейс результата проверки" />
        <type-PageReport PURPOSE="TS-интерфейс отчёта по странице" />
        <type-AuditState PURPOSE="TS-тип стейт-машины аудита" />
      </annotations>
    </M-AUDIT-UI>

